generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════
// 用户与认证
// ════════════════════════════════════════════

model User {
  id           String   @id @default(uuid())
  _openid      String   @default("") @db.VarChar(64)
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  phone        String?  @db.VarChar(32)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.Text
  status       String   @default("active") @db.VarChar(32)
  role         String   @default("member") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  ownedTeams    Team[]
  teamMembers   TeamMember[]
  createdProjects Project[] @relation("ProjectCreator")
  createdTasks    AnalysisTask[] @relation("TaskCreator")

  @@map("users")
}

// ════════════════════════════════════════════
// 团队与权限
// ════════════════════════════════════════════

model Team {
  id               String   @id @default(uuid())
  _openid          String   @default("") @db.VarChar(64)
  teamName         String   @map("team_name") @db.VarChar(255)
  ownerUserId      String   @map("owner_user_id") @db.VarChar(36)
  planType         String   @default("free") @map("plan_type") @db.VarChar(32)
  monthlyQuota     Int      @default(1000000) @map("monthly_quota")
  usedQuota        Int      @default(0) @map("used_quota")
  whiteLabelConfig Json?    @map("white_label_config")
  status           String   @default("active") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  owner     User         @relation("TeamOwner", fields: [ownerUserId], references: [id])
  members   TeamMember[]
  projects  Project[]
  tasks     AnalysisTask[]
  brands    Brand[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  _openid  String   @default("") @db.VarChar(64)
  teamId   String   @map("team_id") @db.VarChar(36)
  userId   String   @map("user_id") @db.VarChar(36)
  role     String   @default("member") @db.VarChar(32)
  status   String   @default("active") @db.VarChar(32)
  joinedAt DateTime @default(now()) @map("joined_at") @db.DateTime(3)

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

// ════════════════════════════════════════════
// 品类
// ════════════════════════════════════════════

model Category {
  id                  String   @id @default(uuid())
  _openid             String   @default("") @db.VarChar(64)
  name                String   @unique @db.VarChar(255)
  slug                String   @unique @db.VarChar(255)
  icon                String?  @db.VarChar(16)
  description         String?  @db.Text
  knowledgeBase       Json     @map("knowledge_base")
  complianceRules     Json     @map("compliance_rules")
  platformMethodology Json     @map("platform_methodology")
  sortOrder           Int      @default(0) @map("sort_order")
  status              String   @default("active") @db.VarChar(32)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  projects Project[]

  @@map("categories")
}

// ════════════════════════════════════════════
// 品牌
// ════════════════════════════════════════════

model Brand {
  id            String   @id @default(uuid())
  _openid       String   @default("") @db.VarChar(64)
  teamId        String   @map("team_id") @db.VarChar(36)
  name          String   @db.VarChar(255)
  industry      String?  @db.VarChar(255)
  positioning   String?  @db.Text
  tone          String?  @db.VarChar(255)
  sellingPoints Json?    @map("selling_points")
  taboos        Json?    
  competitorIds Json?    @map("competitor_ids")
  status        String   @default("active") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  team     Team          @relation(fields: [teamId], references: [id])
  products BrandProduct[]

  @@map("brands")
}

model BrandProduct {
  id          String   @id @default(uuid())
  _openid     String   @default("") @db.VarChar(64)
  brandId     String   @map("brand_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(255)
  priceRange  String?  @map("price_range") @db.VarChar(64)
  status      String   @default("active") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  brand Brand @relation(fields: [brandId], references: [id])

  @@map("brand_products")
}

// ════════════════════════════════════════════
// 项目
// ════════════════════════════════════════════

model Project {
  id          String    @id @default(uuid())
  _openid     String    @default("") @db.VarChar(64)
  teamId      String    @map("team_id") @db.VarChar(36)
  categoryId  String?   @map("category_id") @db.VarChar(36)
  projectName String    @map("project_name") @db.VarChar(255)
  brandName   String?   @map("brand_name") @db.VarChar(255)
  productName String?   @map("product_name") @db.VarChar(255)
  industry    String?   @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(32)
  createdBy   String    @map("created_by") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  team     Team      @relation(fields: [teamId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  creator  User      @relation("ProjectCreator", fields: [createdBy], references: [id])
  tasks    AnalysisTask[]

  @@map("projects")
}

// ════════════════════════════════════════════
// 分析任务
// ════════════════════════════════════════════

model AnalysisTask {
  id             String    @id @default(uuid())
  _openid        String    @default("") @db.VarChar(64)
  teamId         String    @map("team_id") @db.VarChar(36)
  projectId      String    @map("project_id") @db.VarChar(36)
  taskName       String    @map("task_name") @db.VarChar(255)
  platform       String    @db.VarChar(32)
  contentUrl     String?   @map("content_url") @db.Text
  contentTitle   String?   @map("content_title") @db.VarChar(255)
  contentBody    String?   @map("content_body") @db.Text
  contentGoal    String?   @map("content_goal") @db.VarChar(64)
  contentData    Json?     @map("content_data")
  brandInfo      Json?     @map("brand_info")
  productInfo    Json?     @map("product_info")
  competitorInfo Json?     @map("competitor_info")
  outputOptions  Json?     @map("output_options")
  status         String    @default("draft") @db.VarChar(32)
  progress       Json?
  createdBy      String    @map("created_by") @db.VarChar(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  startedAt      DateTime? @map("started_at") @db.DateTime(3)
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)

  team    Project @relation(fields: [projectId], references: [id])
  creator User    @relation("TaskCreator", fields: [createdBy], references: [id])

  comments            Comment[]
  contentAnalyses     ContentAnalysis[]
  commentInsights     CommentInsight[]
  strategyCards       StrategyCard[]
  productionCards     ProductionCard[]
  prePublishChecks    PrePublishCheck[]
  reports             Report[]

  @@map("analysis_tasks")
}

// ════════════════════════════════════════════
// 评论数据
// ════════════════════════════════════════════

model Comment {
  id                String    @id @default(uuid())
  _openid           String    @default("") @db.VarChar(64)
  taskId            String    @map("task_id") @db.VarChar(36)
  commentIdExternal String?   @map("comment_id_external") @db.VarChar(255)
  parentCommentId   String?   @map("parent_comment_id") @db.VarChar(255)
  userIdHash        String?   @map("user_id_hash") @db.VarChar(255)
  commentText       String    @map("comment_text") @db.Text
  normalizedText    String?   @map("normalized_text") @db.Text
  likeCount         Int       @default(0) @map("like_count")
  replyCount        Int       @default(0) @map("reply_count")
  createdAtExternal DateTime? @map("created_at_external") @db.DateTime(3)
  cleanStatus       String    @default("pending") @map("clean_status") @db.VarChar(32)
  valueScore        Int       @default(0) @map("value_score")
  sentimentLabel    String?   @map("sentiment_label") @db.VarChar(32)
  signalLabels      Json?     @map("signal_labels")
  extraData         Json?     @map("extra_data")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  task AnalysisTask @relation(fields: [taskId], references: [id])

  @@index([taskId, cleanStatus])
  @@index([taskId, valueScore])
  @@map("comments")
}

// ════════════════════════════════════════════
// AI 分析结果
// ════════════════════════════════════════════

model ContentAnalysis {
  id           String   @id @default(uuid())
  _openid      String   @default("") @db.VarChar(64)
  taskId       String   @map("task_id") @db.VarChar(36)
  analysisJson Json     @map("analysis_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  task AnalysisTask @relation(fields: [taskId], references: [id])

  @@map("content_analyses")
}

model CommentInsight {
  id          String   @id @default(uuid())
  _openid     String   @default("") @db.VarChar(64)
  taskId      String   @map("task_id") @db.VarChar(36)
  insightType String   @map("insight_type") @db.VarChar(32)
  insightJson Json     @map("insight_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task AnalysisTask @relation(fields: [taskId], references: [id])

  @@map("comment_insights")
}

model StrategyCard {
  id        String   @id @default(uuid())
  _openid   String   @default("") @db.VarChar(64)
  taskId    String   @map("task_id") @db.VarChar(36)
  priority  String   @db.VarChar(16)
  title     String   @db.VarChar(255)
  platform  String?  @db.VarChar(32)
  cardJson  Json     @map("card_json")
  status    String   @default("pending") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  task            AnalysisTask     @relation(fields: [taskId], references: [id])
  productionCards ProductionCard[]

  @@map("strategy_cards")
}

model ProductionCard {
  id             String   @id @default(uuid())
  _openid        String   @default("") @db.VarChar(64)
  taskId         String   @map("task_id") @db.VarChar(36)
  strategyCardId String?  @map("strategy_card_id") @db.VarChar(36)
  platform       String   @db.VarChar(32)
  cardJson       Json     @map("card_json")
  status         String   @default("pending") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  task         AnalysisTask  @relation(fields: [taskId], references: [id])
  strategyCard StrategyCard? @relation(fields: [strategyCardId], references: [id])

  @@map("production_cards")
}

model PrePublishCheck {
  id        String   @id @default(uuid())
  _openid   String   @default("") @db.VarChar(64)
  taskId    String   @map("task_id") @db.VarChar(36)
  score     Int
  checkJson Json     @map("check_json")
  status    String   @default("pending") @db.VarChar(32)
  createdBy String   @map("created_by") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task AnalysisTask @relation(fields: [taskId], references: [id])

  @@map("pre_publish_checks")
}

model Report {
  id          String   @id @default(uuid())
  _openid     String   @default("") @db.VarChar(64)
  taskId      String   @map("task_id") @db.VarChar(36)
  reportType  String   @default("full") @map("report_type") @db.VarChar(32)
  reportTitle String   @map("report_title") @db.VarChar(255)
  reportJson  Json     @map("report_json")
  version     Int      @default(1)
  status      String   @default("draft") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  task AnalysisTask @relation(fields: [taskId], references: [id])

  @@map("reports")
}

// ════════════════════════════════════════════
// AI 治理
// ════════════════════════════════════════════

model ModelProvider {
  id              String   @id @default(uuid())
  _openid         String   @default("") @db.VarChar(64)
  providerName    String   @map("provider_name") @db.VarChar(64)
  baseUrl         String   @map("base_url") @db.VarChar(512)
  apiKeyEncrypted String   @map("api_key_encrypted") @db.Text
  status          String   @default("active") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  modelConfigs ModelConfig[]

  @@map("model_providers")
}

model ModelConfig {
  id               String   @id @default(uuid())
  _openid          String   @default("") @db.VarChar(64)
  providerId       String   @map("provider_id") @db.VarChar(36)
  modelName        String   @map("model_name") @db.VarChar(255)
  modelType        String   @default("chat") @map("model_type") @db.VarChar(32)
  contextWindow    Int      @default(128000) @map("context_window")
  inputTokenPrice  Float    @default(0) @map("input_token_price")
  outputTokenPrice Float    @default(0) @map("output_token_price")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  provider ModelProvider @relation(fields: [providerId], references: [id])

  @@map("model_configs")
}

model AiAgent {
  id             String   @id @default(uuid())
  _openid        String   @default("") @db.VarChar(64)
  agentName      String   @map("agent_name") @db.VarChar(255)
  agentCode      String   @unique @map("agent_code") @db.VarChar(64)
  agentVersion   String   @default("1.0.0") @map("agent_version") @db.VarChar(32)
  status         String   @default("active") @db.VarChar(32)
  executionOrder Int      @default(0) @map("execution_order")
  canParallel    Boolean  @default(false) @map("can_parallel")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ai_agents")
}

model AuditLog {
  id           String   @id @default(uuid())
  _openid      String   @default("") @db.VarChar(64)
  teamId       String?  @map("team_id") @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  action       String   @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(36)
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@map("audit_logs")
}
